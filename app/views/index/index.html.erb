<div id="map_legend">
  <turbo-frame id="map_legend_frame" src="/filters">
    <p>Loading...</p>
  </turbo-frame>
</div>
<div id="search_area_legend">
  <turbo-frame id="current_search_area_frame" src="/current_search_area">
    <p>Loading...</p>
  </turbo-frame>
</div>
<div id="map"></div>

<script type="text/javascript">
  // Map initialization
  var map = L.map('map');
  <% if @search_area %>
    map.fitBounds([
      [<%= @search_area.lat_min %>, <%= @search_area.lng_min %>],
      [<%= @search_area.lat_max %>, <%= @search_area.lng_max %>]
    ]);
  <% else %>
    map.setView([49.19, -123.98], 13);
  <% end %>
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
  }).addTo(map);

  var markers = []
  var marker_icons = {
    <% 7.times do |i| j = i + 1 %>
      house<%= j %>: L.icon({
        iconUrl: '<%= image_path("house#{j}") %>',
        iconSize: [20,20],
        iconAnchor: [10,10]
      }),
      house<%= j %>new: L.icon({
        iconUrl: '<%= image_path("house#{j}new") %>',
        iconSize: [30,30],
        iconAnchor: [15,15]
      }),
      house<%= j %>recent: L.icon({
        iconUrl: '<%= image_path("house#{j}recent") %>',
        iconSize: [30,30],
        iconAnchor: [15,15]
      }),
      star<%= j %>: L.icon({
        iconUrl: '<%= image_path("star#{j}") %>',
        iconSize: [20,20],
        iconAnchor: [10,10]
      }),
    <% end %>
  }
</script>
